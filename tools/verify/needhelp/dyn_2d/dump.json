      "code": true,
      "lines": [
       "#define N 4",
       "int **strict_upper(int A[][N], int n)",
       "{",
       "    int i, j;",
       "    int **up = (int **)calloc(n, sizeof(int *));",
       "    for (i = 0; i < n; i++)",
       "    {",
       "        up[i] = (int *)calloc(n - 1 - i, sizeof(int));",
       "        for (j = i + 1; j < n; j++)",
       "            up[i][j] = A[i][j];",
       "    }",
       "    return up;",
       "}"
